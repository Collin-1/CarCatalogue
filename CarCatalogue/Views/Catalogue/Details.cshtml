@model CarCatalogue.Models.Car
@{
	ViewData["Title"] = "CarIndex";
}

<div class="container">
	<div class="d-flex justify-content-center">
		<h3>@Model.Name</h3>
	</div>
	<div class="d-flex justify-content-center">
		<img src="@Model.ImageUrl" style="width: 50%" />
	</div>
	<div class="d-flex justify-content-center">
		@Model.Price.ToString("N2") Rands
	</div>
	<div class="d-flex justify-content-center">
		Specifications:
		<ul>
			@foreach(var item in Model.CarSpecs)
			{
				<li>
					@item.Spec.Name
				</li>
			}
		</ul>
	</div>
	<a class="btn btn-info" asp-action="Index">Back to the Catalogue</a>
</div>
